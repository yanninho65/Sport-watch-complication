<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!--
         Carte "match suivi" : visible uniquement quand un suivi est actif
         (voir MainActivity.showFollowedCard / hideFollowedCard). Le
         polling réel tourne dans MatchFollowService, pas dans l'Activity —
         cette carte ne fait qu'en refléter l'état (via FollowedMatchPrefs
         au démarrage, puis via un broadcast pendant que l'app est ouverte).
    -->
    <LinearLayout
        android:id="@+id/followedMatchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A000000"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textFollowedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textFollowedDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <Button
            android:id="@+id/buttonStopFollowing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Arrêter le suivi" />

    </LinearLayout>

    <!--
         Repli "pas de match sélectionné" : lit les notifications Sofascore
         via SofascoreNotificationListenerService. L'accès aux notifications
         est une permission spéciale (pas demandable au runtime comme
         POST_NOTIFICATIONS) — ce bouton ouvre directement l'écran système
         où Yann doit l'accorder à la main. Toujours visible, indépendamment
         du mode de recherche (TheSportsDB/tennis) — voir MainActivity.
    -->
    <Button
        android:id="@+id/buttonNotificationAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Activer l'accès aux notifications (repli Sofascore)" />

    <!--
         Choix du repli Sofascore : "dernière notif" (auto, par défaut) ou
         un match précis parmi ceux actuellement dans le centre de
         notifications — voir MainActivity.showSofascorePicker(). Ouvre la
         liste dans la zone de recherche habituelle (recyclerView).
    -->
    <Button
        android:id="@+id/buttonSofascoreFallback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Repli Sofascore : dernière notif (changer)" />

    <!--
         Question 1 : quelle API interroger — TheSportsDB (multi-sport) ou
         Live Tennis API (tennis uniquement). Voir MainActivity.ApiMode et
         LiveTennisApi.kt. Le volley n'a pas été retenu comme 3e option :
         couverture jugée trop limitée côté API gratuites (voir README).
    -->
    <RadioGroup
        android:id="@+id/radioApi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/radioApiSportsDb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TheSportsDB"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioApiTennis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Live Tennis API" />

    </RadioGroup>

    <!--
         Question 2 (TheSportsDB uniquement, masqué en tennis où le sport
         "Tennis" est implicite) : quel sport. "Tous sports" (par défaut)
         ne filtre rien côté client — voir MainActivity.SportsDbSport et
         SportsDbApi.kt. Les sports précis restent disponibles pour qui
         veut activement restreindre sa recherche ; avec la clé gratuite,
         en pratique seul Football renvoie des résultats fiables (voir
         "Limites connues" du README).
    -->
    <RadioGroup
        android:id="@+id/radioSportsDbSport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/radioSdbAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tous sports"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioSdbSoccer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Football" />

        <RadioButton
            android:id="@+id/radioSdbBasketball"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Basketball" />

        <RadioButton
            android:id="@+id/radioSdbHandball"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Handball" />

        <RadioButton
            android:id="@+id/radioSdbRugby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rugby" />

        <RadioButton
            android:id="@+id/radioSdbVolleyball"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volleyball" />

    </RadioGroup>

    <!--
         Clé Live Tennis API — visible uniquement en mode "Live Tennis
         API" (voir MainActivity.showSearchState). Saisie ICI et stockée
         en local (TennisApiKeyPrefs.kt), JAMAIS dans le code source :
         le dépôt GitHub est public.
    -->
    <LinearLayout
        android:id="@+id/tennisApiKeyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/editTennisApiKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Clé Live Tennis API"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/buttonSaveTennisApiKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enregistrer la clé" />

    </LinearLayout>

    <!-- Choix du mode de recherche : équipe (comportement historique), joueur ou ligue — pour TheSportsDB uniquement. Masqué en tennis (recherche par joueur uniquement) — voir MainActivity.showSearchState. -->
    <RadioGroup
        android:id="@+id/radioSearchMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/radioModeTeam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Équipe"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioModePlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Joueur" />

        <RadioButton
            android:id="@+id/radioModeLeague"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ligue" />

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nom d'équipe (ex. PSG)"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <Button
            android:id="@+id/buttonSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rechercher" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonBackToSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="← Retour à la recherche"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textStyle="italic"
        android:text="Cherche une équipe, un joueur ou une ligue pour commencer" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>
